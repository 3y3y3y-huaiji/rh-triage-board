{
  "name": "rh-triage-board",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Pure-static Cloudflare Pages triage board for leanprover-community/riemann-hypothesis: merge queue, conflict radar, mega-refactor alerts, and up-for-grabs tasks.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "fetch:board": "node scripts/fetch-board.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "e2e": "node scripts/e2e-ui.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
